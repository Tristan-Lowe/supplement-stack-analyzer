# Postgres connection string. Use a Neon or Supabase free-tier database.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# Anthropic API key for the offline extraction pipeline.
ANTHROPIC_API_KEY=sk-ant-...

# Extraction model. Chosen by measurement, not reputation: on a real FDA
# levothyroxine section Haiku 4.5 extracted 51 triples with 100% span
# verification for $0.039, against Opus 5's 49 triples for ~$0.27.
# Re-measure before changing it.
EXTRACTION_MODEL=claude-haiku-4-5
